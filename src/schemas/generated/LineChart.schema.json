{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LineChartProps",
  "definitions": {
    "LineChartProps": {
      "$ref": "#/definitions/LineChartProps%3CChartDatum%3E"
    },
    "LineChartProps<ChartDatum>": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChartDatum"
          }
        },
        "xKey": {
          "type": [
            "string"
          ]
        },
        "yKey": {
          "type": [
            "string"
          ]
        },
        "className": {
          "type": "string"
        },
        "lineColor": {
          "type": "string"
        },
        "areaColor": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": [
                  "string"
                ]
              },
              "color": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "areaColor": {
                "type": "string"
              }
            },
            "required": [
              "key"
            ]
          }
        },
        "showXAxis": {
          "type": "boolean"
        },
        "showYAxis": {
          "type": "boolean"
        },
        "showGridRows": {
          "type": "boolean"
        },
        "showGridColumns": {
          "type": "boolean"
        },
        "xAxisLabel": {
          "type": "string"
        },
        "yAxisLabel": {
          "type": "string"
        },
        "margin": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number"
            },
            "right": {
              "type": "number"
            },
            "bottom": {
              "type": "number"
            },
            "left": {
              "type": "number"
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "yDomain": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "emptyMessage": {
          "type": "string",
          "description": "Rendered in place of the chart when `data` holds no plottable rows."
        },
        "ariaLabel": {
          "type": "string",
          "description": "Accessible name for the chart. Falls back to a generated summary."
        },
        "ariaDescribedby": {
          "type": "string",
          "description": "Id of an element elsewhere on the page that describes the chart."
        },
        "title": {
          "type": "string",
          "description": "Human title rendered into the SVG's `<title>`."
        },
        "description": {
          "type": "string",
          "description": "Long description rendered into the SVG's `<desc>`. Falls back to a generated one."
        },
        "keyboardNavigable": {
          "type": "boolean",
          "description": "Set false to make the chart inert to Tab and the arrow keys. Defaults to true."
        }
      },
      "required": [
        "data",
        "xKey"
      ]
    },
    "ChartDatum": {
      "type": "object",
      "additionalProperties": {},
      "description": "The row shape the generic charts are instantiated at. An open record is the widest type that still resolves `keyof T` to `string`, so a generated schema accepts any caller's row type rather than one sample's fields."
    }
  }
}
