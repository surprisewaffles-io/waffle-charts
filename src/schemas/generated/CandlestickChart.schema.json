{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CandlestickChartProps",
  "definitions": {
    "CandlestickChartProps": {
      "$ref": "#/definitions/CandlestickChartProps%3CChartDatum%3E"
    },
    "CandlestickChartProps<ChartDatum>": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChartDatum"
          }
        },
        "xKey": {
          "type": [
            "string"
          ]
        },
        "openKey": {
          "type": [
            "string"
          ]
        },
        "highKey": {
          "type": [
            "string"
          ]
        },
        "lowKey": {
          "type": [
            "string"
          ]
        },
        "closeKey": {
          "type": [
            "string"
          ]
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "className": {
          "type": "string"
        },
        "upColor": {
          "type": "string"
        },
        "downColor": {
          "type": "string"
        },
        "showXAxis": {
          "type": "boolean"
        },
        "showYAxis": {
          "type": "boolean"
        },
        "showGridRows": {
          "type": "boolean"
        },
        "showGridColumns": {
          "type": "boolean"
        },
        "xAxisLabel": {
          "type": "string"
        },
        "yAxisLabel": {
          "type": "string"
        },
        "margin": {
          "type": "object",
          "properties": {
            "top": {
              "type": "number"
            },
            "right": {
              "type": "number"
            },
            "bottom": {
              "type": "number"
            },
            "left": {
              "type": "number"
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left"
          ]
        },
        "emptyMessage": {
          "type": "string",
          "description": "Rendered in place of the chart when `data` holds no plottable rows."
        },
        "ariaLabel": {
          "type": "string",
          "description": "Accessible name for the chart. Falls back to a generated summary."
        },
        "ariaDescribedby": {
          "type": "string",
          "description": "Id of an element elsewhere on the page that describes the chart."
        },
        "title": {
          "type": "string",
          "description": "Human title rendered into the SVG's `<title>`."
        },
        "description": {
          "type": "string",
          "description": "Long description rendered into the SVG's `<desc>`. Falls back to a generated one."
        },
        "keyboardNavigable": {
          "type": "boolean",
          "description": "Set false to make the chart inert to Tab and the arrow keys. Defaults to true."
        }
      },
      "required": [
        "closeKey",
        "data",
        "highKey",
        "lowKey",
        "openKey",
        "xKey"
      ]
    },
    "ChartDatum": {
      "type": "object",
      "additionalProperties": {},
      "description": "The row shape the generic charts are instantiated at. An open record is the widest type that still resolves `keyof T` to `string`, so a generated schema accepts any caller's row type rather than one sample's fields."
    }
  }
}
