{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/HeatmapChartProps",
  "definitions": {
    "HeatmapChartProps": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HeatmapData"
          }
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "className": {
          "type": "string"
        },
        "colorRange": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "gap": {
          "type": "number"
        },
        "emptyMessage": {
          "type": "string",
          "description": "Rendered in place of the chart when `data` holds no plottable columns."
        },
        "ariaLabel": {
          "type": "string",
          "description": "Accessible name for the chart. Falls back to a generated summary."
        },
        "ariaDescribedby": {
          "type": "string",
          "description": "Id of an element elsewhere on the page that describes the chart."
        },
        "title": {
          "type": "string",
          "description": "Human title rendered into the SVG's `<title>`."
        },
        "description": {
          "type": "string",
          "description": "Long description rendered into the SVG's `<desc>`. Falls back to a generated one."
        },
        "keyboardNavigable": {
          "type": "boolean",
          "description": "Set false to make the chart inert to Tab and the arrow keys. Defaults to true."
        }
      },
      "required": [
        "data"
      ]
    },
    "HeatmapData": {
      "type": "object",
      "properties": {
        "bin": {
          "type": "number"
        },
        "bins": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bin": {
                "type": "number"
              },
              "count": {
                "type": "number"
              }
            },
            "required": [
              "bin",
              "count"
            ]
          }
        }
      },
      "required": [
        "bin",
        "bins"
      ]
    }
  }
}
